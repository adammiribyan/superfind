    ]
    chosen = subprocess.run(fzf, input=items(recent_first(index())).encode(), stdout=subprocess.PIPE).stdout.decode()
    if not chosen:
        sys.exit(1)
    path, cwd, session_id, config_dir, title = chosen.split("\t")[:5]
    entry = load_cache().get(path) or {}
    active = bool(entry.get("session")) and Session(**entry["session"]).active
    print(title + (f"{RESET}{SECONDARY} · may still be open in another window" if active else ""))
    print(resume_command(cwd, session_id, config_dir))


def resume_command(cwd, session_id, config_dir):
    """The shell command that resumes a session. Deleted worktrees are common, so it runs from the
    nearest directory that still exists, and it names the config dir only when it isn't the default."""
    while not os.path.isdir(cwd):
        cwd = os.path.dirname(cwd)
    default_config = Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".claude")).expanduser().resolve()
    env = "" if Path(config_dir) == default_config else f"CLAUDE_CONFIG_DIR={shlex.quote(str(config_dir))} "
    return f"cd {shlex.quote(cwd)} && {env}claude --resume {session_id}"


def emit(lines):
    """fzf lines on stdout. Nothing at all for no results: a lone newline would be one blank result."""
    if lines:
        print(lines)


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    command = sys.argv[1:2]
    if command == ["preview"]:
        if len(sys.argv) > 2 and sys.argv[2]:
            preview(sys.argv[2])
    elif command == ["pick"]:
        pick()
    elif command == ["search"]:
        ASK_ERROR.unlink(missing_ok=True)
        words = (sys.argv[2] if len(sys.argv) > 2 else "").split()
        wanted = {STATUSES[w[3:]][0] for w in words if w.startswith("is:") and STATUSES.get(w[3:], (None,))[0]}
        rows = cached_rows()
        if wanted:
            known = statuses()
            rows = [r for r in rows if status_label(r[2], known) in wanted]
        found = matches(" ".join(w for w in words if not w.startswith("is:")))
        emit(items(recent_first(rows) if found is None else in_order(rows, found)))
    elif command == ["label"]:
        key = typesafe_key()
        if key:
            label_sessions(key)
    elif command in (["--version"], ["version"]):
        print(f"hop {VERSION}")
    elif command == ["index"]:
        print(f"{len(index())} sessions indexed")
    elif command == ["explain"]:
        key = typesafe_key()
        if key:
            explain(key, sys.argv[2], sys.argv[3:])
    elif command == ["ask"]:
        rows = cached_rows()
        query = sys.argv[2] if len(sys.argv) > 2 else ""
        try:
            emit(items(in_order(rows, ask(query, rows)) if query.strip() else recent_first(rows)))
            ASK_ERROR.unlink(missing_ok=True)
        except AskFailed as failure:
            message = f"Couldn't ask: {failure}."
            ASK_ERROR.parent.mkdir(parents=True, exist_ok=True)
            ASK_ERROR.write_text(message)
            if not os.environ.get("FZF_PORT"):
                sys.exit(message)
    else:
        sys.exit(__doc__)
