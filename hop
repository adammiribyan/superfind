#!/usr/bin/env python3
"""hop: search past AI coding-agent sessions, then hop back into one. Today it reads Claude Code sessions.

  hop pick       run the picker; prints the chosen session's title, then the
                 shell command that resumes it
  hop index      build or refresh the index without opening the picker
  hop preview F  pinned header, then where the session left off, or the recent
                 conversation when fzf's preview label says so
  hop search Q   fzf lines for sessions whose title or conversation contains Q
  hop ask Q      fzf lines for the sessions judged most relevant to Q (by Jev when a
                 TypeSafe key is configured, otherwise by Claude)
  hop label      have Jev judge how each changed session ended (waiting on you,
                 unfinished, finished); runs in the background when the picker opens
  hop explain Q P...
                 save the passage of each transcript P that best shows Q
"""
