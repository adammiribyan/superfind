ACCENT, DIM, BOLD, RESET = "\033[34m", "\033[2m", "\033[1m", "\033[0m"

WORKTREE_MARK = "/.claude/worktrees/"


@dataclass
class Session:
    session_id: str
    cwd: str
    title: str
    last_prompt: str
    branch: str
    prompts: int
    words: int
    tool_calls: int
    mtime: float

    @property
    def project(self):
        root = self.cwd.split(WORKTREE_MARK)[0]
        return Path(root).name or root

    @property
    def throwaway(self):
        """A "hi" or "test" session: sorted last and left out of ask, never hidden. Short sessions that ran
        any tool did real work, so they count."""
        return self.prompts <= 2 and self.words < THROWAWAY_WORDS and not self.tool_calls

    @property
    def active(self):
        """Written in the last two minutes, so probably still open in another window."""
        return time.time() - self.mtime < ACTIVE_SECONDS


def config_dirs():
    candidates = [HOME / ".claude", *sorted(HOME.glob(".claude-*"))]
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        candidates.insert(0, Path(os.environ["CLAUDE_CONFIG_DIR"]).expanduser())
    extra = os.environ.get("HOP_CLAUDE_DIRS", "")
    candidates += [Path(p).expanduser() for p in extra.split(":") if p]
    seen, dirs = set(), []
    for d in candidates:
        d = d.resolve()
        if d not in seen and (d / "projects").is_dir():
            seen.add(d)
            dirs.append(d)
    return dirs


def truecolor(hx, fallback):
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", hx):
        return fallback
    return "\033[38;2;{};{};{}m".format(*(int(hx[i : i + 2], 16) for i in (1, 3, 5)))


SECONDARY = truecolor(os.environ.get("HOP_SECONDARY", ""), DIM)

SLASH_COMMAND = re.compile(r"<command-name>(/?[^<]*)</command-name>.*?(?:<command-args>(.*?)</command-args>|$)", re.S)


def prompt_text(text):
    """What the user typed, with slash commands shown as `/name args`; empty for machine-generated turns."""
    command = SLASH_COMMAND.search(text)
    if command:
        return f"{command.group(1)} {command.group(2) or ''}".strip()
    if text.startswith(("<", "Caveat:", "[Request interrupted", "Another Claude session sent a message", "[SYSTEM NOTIFICATION")):
        return ""
    return text


def message_text(entry):
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    return ""


def parse(path, mtime):
    """(Session or None, the conversation's readable text: prompts and Claude's replies)."""
    cwd = relocated = custom = ai = last_prompt = first_prompt = branch = ""
    prompts = tool_calls = 0
    body = []
    with open(path, "rb") as f:
        for raw in f:
            if b'"type":"user"' in raw and b'"tool_use_id"' not in raw:
                e = json.loads(raw)
                cwd = cwd or e.get("cwd") or ""
                branch = e.get("gitBranch") or branch
                text = prompt_text(message_text(e).strip())
                if not e.get("isMeta") and text:
                    prompts += 1
                    first_prompt = first_prompt or text
                    body.append(text)
            elif b'"type":"assistant"' in raw:
                tool_calls += raw.count(b'"type":"tool_use"')
                if b'"type":"text"' in raw:
                    body.append(message_text(json.loads(raw)))
            elif not cwd and b'"cwd":"' in raw:
                cwd = json.loads(raw).get("cwd") or ""
            elif b'"type":"custom-title"' in raw:
                custom = json.loads(raw).get("customTitle") or custom
            elif b'"type":"ai-title"' in raw:
                ai = json.loads(raw).get("aiTitle") or ai
            elif b'"type":"last-prompt"' in raw:
                last_prompt = json.loads(raw).get("lastPrompt") or last_prompt
            elif b'"type":"relocated"' in raw:
                relocated = json.loads(raw).get("relocatedCwd") or relocated
    cwd = relocated or cwd
    if not cwd or not (first_prompt or last_prompt):
        return None, ""
    title = custom or ai or first_prompt or last_prompt
    text = "\n".join(body)
    return Session(path.stem, cwd, title, last_prompt or first_prompt, branch, max(prompts, 1), len(text.split()), tool_calls, mtime), text


def one_line(text, width):
    text = " ".join(text.split())
    return text if len(text) <= width else text[: width - 1] + "…"


def tilde(path):
    home = str(HOME)
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path


def load_cache():
    try:
        data = json.loads(CACHE.read_text())
        return data["files"] if data.get("version") == CACHE_VERSION else {}
    except (OSError, ValueError, KeyError):
        return {}


def save_cache(files):
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    tmp = CACHE.with_suffix(".tmp")
    tmp.write_text(json.dumps({"version": CACHE_VERSION, "files": files}))
    tmp.replace(CACHE)


def same_file(entry, st):
    """Whether a cached record still describes the transcript, judged by modification time and size."""
    return bool(entry) and entry["mtime"] == st.st_mtime and entry["size"] == st.st_size


def search_db():
    SEARCH_DB.parent.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(SEARCH_DB)
    db.execute("CREATE VIRTUAL TABLE IF NOT EXISTS docs USING fts5(path UNINDEXED, title, body, tokenize='porter unicode61')")
    return db


def index():
    """Every session as (Session, config dir, path), re-parsing only transcripts that changed.
    The JSON cache and the full-text index are updated together, so they always describe the same files."""
    old, new = load_cache(), {}
    found = [(config_dir, path, path.stat()) for config_dir in config_dirs()
             for path in (config_dir / "projects").glob("*/*.jsonl")]
    stale = [path for _, path, st in found if not same_file(old.get(str(path)), st)]
    notice = len(stale) > INDEXING_NOTICE_AT and sys.stderr.isatty()
    if notice:
        sys.stderr.write(f"  Indexing {len(stale)} sessions…")
        sys.stderr.flush()
    stale = set(stale)
    rows, changed = [], []
    for config_dir, path, st in found:
        key = str(path)
        if path in stale:
            try:
                session, body = parse(path, st.st_mtime)
            except (OSError, ValueError):
                session, body = None, ""
            changed.append((key, session, body))
        else:
            session = Session(**old[key]["session"]) if old[key]["session"] else None
        new[key] = {"mtime": st.st_mtime, "size": st.st_size, "session": session and asdict(session)}
        if session:
            rows.append((session, config_dir, path))
    if notice:
        sys.stderr.write("\r\033[K")
    gone = old.keys() - new.keys()
    if changed or gone or not SEARCH_DB.exists():
        with search_db() as db:
            for key in [k for k, _, _ in changed] + list(gone):
                db.execute("DELETE FROM docs WHERE path = ?", (key,))
            db.executemany(
                "INSERT INTO docs (path, title, body) VALUES (?, ?, ?)",
                [(k, f"{s.title} {s.project} {s.branch}", body) for k, s, body in changed if s],
            )
    if new != old:
        save_cache(new)
    return rows


def cached_rows():
    """The sessions as last indexed, without touching transcripts: fast enough to run on every keystroke."""
    dirs = config_dirs()
    rows = []
    for key, entry in load_cache().items():
        if entry["session"]:
            path = Path(key)
            config_dir = next((d for d in dirs if key.startswith(str(d) + "/")), path.parents[2])
            rows.append((Session(**entry["session"]), config_dir, path))
    return rows


def fts_query(query):
    """Every meaningful word must match, as a prefix, so "autom" finds "automation" while you type."""
    words = [w for w in re.findall(r"\w+", query.lower()) if w not in STOPWORDS]
    return " ".join(f'"{w}"*' for w in words)


def matches(query):
    """Transcript paths matching the query: every title match first, then conversation matches, each by relevance."""
    match = fts_query(query)
    if not match:
        return None
    found = []
    with search_db() as db:
        for scoped in (f"title : ({match})", match):
            for (path,) in db.execute("SELECT path FROM docs WHERE docs MATCH ? ORDER BY rank LIMIT 200", (scoped,)):
                if path not in found:
                    found.append(path)
    return found


STOPWORDS = set("""a about all an and any are as at be been but by can could did do does for from had has have
how i if in into is it its me my of on or our so that the their them then there these they this those to
up us was we were what when where which who why will with would you your""".split())

ASK_PROMPT = (
    "You rank a developer's past coding sessions by how relevant they are to a search. Each session is one "
    "numbered line: title | project | age | last request | a passage from the conversation. Judge by meaning, "
    "not shared words. Reply with only a JSON array of the numbers of up to 15 relevant sessions, best first, "
    "or [] if none are relevant."
)


def ask_cards(query, rows):
    """(rows, one card per row): the evidence any ranker sees about each session for this query."""
    rows = [r for r in recent_first(rows) if not r[0].throwaway]
    words = [w for w in re.findall(r"\w+", query.lower()) if w not in STOPWORDS]
    any_word = " OR ".join(f'"{w}"*' for w in words)
    with search_db() as db:
        passages = dict(db.execute("SELECT path, substr(body, 1, 240) FROM docs"))
        if any_word:
            passages.update(db.execute(
                "SELECT path, snippet(docs, 2, '', '', '…', 40) FROM docs WHERE docs MATCH ?", (any_word,)))
    cards = [
        f"{s.title} | {s.project} | {ago(s.mtime)} | {one_line(s.last_prompt, 160)} | "
        f"{one_line(passages.get(str(path), ''), 300)}"
        for s, _, path in rows
    ]
    return rows, cards


def typesafe_key():
    """TYPESAFE_API_KEY from the environment, or from a .env file next to this script. Setting it to an
    empty value turns Jev off."""
    if "TYPESAFE_API_KEY" in os.environ:
        return os.environ["TYPESAFE_API_KEY"] or None
    try:
        found = re.search(r'^\s*(?:export\s+)?TYPESAFE_API_KEY\s*=\s*["\']?([^"\'\s]+)',
                          (Path(__file__).resolve().parent / ".env").read_text(), re.M)
    except OSError:
        return None
    return found and found.group(1)


def jev(key, state, questions):
    request = urllib.request.Request(
        JEV_URL, data=json.dumps({"model": "jev-latest", "state": state, "questions": questions}).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)["answers"]


def jev_rank(key, query, rows, cards):
    """Two stages: shortlist likely sessions out of every card, then a yes/no on each shortlisted one.
    Final order adds both probabilities, so a confident shortlist pick survives a hesitant second look."""
    chunks = [range(start, min(start + JEV_CHUNK, len(cards))) for start in range(0, len(cards), JEV_CHUNK)]
    if not chunks:
        return []

    def shortlist(indices):
        criteria = {f"s{i}": cards[i] for i in indices}
        criteria["none"] = "None of these sessions is where the developer did this work."
        answer = jev(key, {"search": query}, {"which": {
            "type": "choice",
            "instructions": "A developer is searching their past AI coding sessions with `search`. "
                            "Which session is the one where they did the work the search describes?",
            "criteria": criteria}})["which"]["probabilities"]
        best = sorted((k for k in answer if k != "none"), key=answer.get, reverse=True)[:JEV_SHORTLIST]
        return {int(k[1:]): answer[k] for k in best}

    with ThreadPoolExecutor(len(chunks)) as pool:
        first = {i: p for picks in pool.map(shortlist, chunks) for i, p in picks.items()}
    second = jev(key, {"search": query, "sessions": {f"s{i}": cards[i] for i in first}}, {
        f"s{i}": {
            "type": "noul",
            "instructions": f"Is session `sessions.s{i}` the one where the developer did the work described by `search`?",
            "criteria": {"true": "The session's title, requests, or passage show this specific work.",
                         "false": "The session is only related in topic, or covers a different task."},
        }
        for i in first
    })
    order = sorted(first, key=lambda i: first[i] + second[f"s{i}"]["noul"], reverse=True)
    return [str(rows[i][2]) for i in order]


def passages_of(body, query, limit=120):
    """The conversation cut into paragraph-sized passages, those sharing a word with the query first."""
    pieces, current = [], ""
    for paragraph in re.split(r"\n\s*\n", body):
        paragraph = " ".join(paragraph.split())
        if current and len(current) + len(paragraph) > 400:
            pieces.append(current)
            current = ""
        current = f"{current} {paragraph}".strip()
    if current:
        pieces.append(current)
    words = [w for w in re.findall(r"\w+", query.lower()) if w not in STOPWORDS and len(w) > 2]
    pieces.sort(key=lambda piece: not any(w in piece.lower() for w in words))
    return [piece[:400] for piece in pieces[:limit]]


def explain(key, query, paths):
    """For each path, the passage Jev judges best shows the searched-for work; saved for the preview."""
    with search_db() as db:
        bodies = {p: b for p, b in db.execute(
            f"SELECT path, body FROM docs WHERE path IN ({','.join('?' * len(paths))})", paths)}

    def pick(path):
        pieces = passages_of(bodies.get(path, ""), query)
        if not pieces:
            return path, None
        criteria = {f"p{i}": piece for i, piece in enumerate(pieces)}
        criteria["none"] = "No passage shows this work."
        answer = jev(key, {"search": query}, {"which": {
            "type": "choice",
            "instructions": "Which passage from this coding session best shows the work described by `search`?",
            "criteria": criteria}})["which"]
        return path, None if answer["choice"] == "none" else criteria[answer["choice"]]

    with ThreadPoolExecutor(max(1, len(paths))) as pool:
        found = {path: passage for path, passage in pool.map(pick, paths) if passage}
    EXPLAINED.write_text(json.dumps({"query": query, "passages": found}))
    port = os.environ.get("FZF_PORT")
    if port:
        urllib.request.urlopen(urllib.request.Request(
            f"http://localhost:{port}", data=b"refresh-preview", method="POST"), timeout=2).close()


def explained(path, query):
    try:
        saved = json.loads(EXPLAINED.read_text())
    except (OSError, ValueError):
        return ""
    passage = saved["passages"].get(path, "") if saved.get("query") == query else ""
    return " ".join(re.sub(r"[*`#]+", "", passage).split())


class AskFailed(Exception):
    pass


def ask(query, rows):
    """Paths of the sessions ranked most relevant to the query, best first: by Jev when a TypeSafe key
    is configured, by Claude otherwise or if Jev fails. Raises AskFailed, naming what failed, when neither answers."""
    key = typesafe_key()
    if key:
        rows, cards = ask_cards(query, rows)
        try:
            ranked = jev_rank(key, query, rows, cards)
        except (OSError, ValueError, KeyError):
            ranked = None
        if ranked:
            subprocess.Popen([os.path.abspath(sys.argv[0]), "explain", query, *ranked[:EXPLAIN_TOP]],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            return ranked
    try:
        return claude_rank(query, rows)
    except AskFailed:
        raise AskFailed("TypeSafe and Claude didn't answer" if key else "Claude Code didn't answer") from None


def claude_rank(query, rows):
    """Paths of the sessions Claude ranks as most relevant to the query, best first."""
    rows, cards = ask_cards(query, rows)
    request = f"Search: {query}\n\nSessions:\n" + "\n".join(f"{i}. {card}" for i, card in enumerate(cards))
    base = ["claude", "-p", "--model", "haiku", "--no-session-persistence", "--tools", "",
            "--output-format", "json", "--system-prompt", ASK_PROMPT]
    ranked = None
    for command in (base + ["--bare"], base):
        try:
            reply = subprocess.run(command, input=request, capture_output=True, text=True, timeout=90)
            ranked = json.loads(re.search(r"\[[\d,\s]*\]", json.loads(reply.stdout)["result"]).group())
            break
        except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError, AttributeError):
            continue
    if ranked is None:
        raise AskFailed("Claude Code didn't answer")
    return [str(rows[i][2]) for i in ranked if isinstance(i, int) and 0 <= i < len(rows)]


def snippet(path, query):
    match = fts_query(query)
    if not match:
        return ""
    with search_db() as db:
        row = db.execute(
            "SELECT snippet(docs, 2, ?, ?, '…', 10) FROM docs WHERE docs MATCH ? AND path = ?",
            (f"{BOLD}{ACCENT}", RESET, match, path)).fetchone()
    return " ".join(row[0].split()) if row and row[0] else ""


def ago(mtime, now=None):
    seconds = (now or time.time()) - mtime
    for limit, unit, label in ((60, 1, "just now"), (3600, 60, "m"), (86400, 3600, "h"), (7 * 86400, 86400, "d")):
        if seconds < limit:
            return label if unit == 1 else f"{int(seconds // unit)}{label} ago"
    fmt = "%b %-d" if time.localtime(mtime).tm_year == time.localtime().tm_year else "%b %-d %Y"
    return time.strftime(fmt, time.localtime(mtime))


def when(s):
    return "active now" if s.active else ago(s.mtime)


def is_here(s):
    return s.cwd == os.environ.get("PWD")


def meta_parts(s, config_dir, show_account, status=None):
    """Project and age lead so a long branch never pushes recency out of view."""
    parts = [s.project] + ([status] if status else []) + [when(s)]
    if s.branch and s.branch != "HEAD":
        parts.append(s.branch)
    parts.append(f"{s.prompts} prompt" + ("" if s.prompts == 1 else "s"))
    if show_account:
        parts.append(config_dir.name)
    return parts


def recent_first(rows):
    """Sessions from the directory the picker was opened in first, then by recency, throwaway sessions last."""
    return sorted(rows, key=lambda r: (not r[0].throwaway, is_here(r[0]), r[0].mtime), reverse=True)


def in_order(rows, paths):
    by_path = {str(r[2]): r for r in rows}
    return [by_path[p] for p in paths if p in by_path]


def items(rows):
    """Tab-separated fzf lines: path, cwd, session id, config dir, title, then the display."""
    show_account = len({r[1] for r in rows}) > 1
    known = statuses()
    out = []
    for s, config_dir, path in rows:
        status = status_label(path, known)
        if status == STATUSES["waiting"][0]:
            flag = f"{ACCENT}{status}{RESET}{SECONDARY} · "
        elif status:
            flag = f"{status} · "
        else:
            flag = ""
        context = f"{flag}{when(s)} · {s.project}" + ("" if os.path.isdir(s.cwd) else " · folder removed")
        if show_account:
            context += f" · {config_dir.name}"
        title = " ".join(s.title.split())
        display = f" {title}  {SECONDARY}{context}{RESET}"
        out.append(f"{path}\t{s.cwd}\t{s.session_id}\t{config_dir}\t{title}\t{display}")
    return "\n".join(out)


CODE_SPAN = re.compile(r"`([^`]+)`")
BOLD_START, BOLD_END = "\x01", "\x02"


def bold_across_lines(wrapped):
    """Turn bold markers into ANSI per wrapped line, reopening bold when a span continues onto the next line."""
    out, inside = [], False
    for w in wrapped:
        line = ((BOLD if inside else "") + w).replace(BOLD_START, BOLD).replace(BOLD_END, RESET)
        inside ^= (w.count(BOLD_START) + w.count(BOLD_END)) % 2 == 1
        out.append(line + (RESET if inside else ""))
    return out


def clip(line, width):
    return line if len(line) <= width else line[: width - 1] + f"{DIM}…{RESET}"


def render(text, width):
    """Light Markdown: bold headings, framed tables and code kept at full contrast, prose wrapped."""
    lines, fenced = [], False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            lines.append("    " + clip(line, width - 4))
        elif stripped.startswith("|"):
            cells = clip(stripped, width - 2)
            lines.append("  " + re.sub(r"\|", f"{DIM}|{RESET}", cells))
        elif stripped.startswith("#"):
            lines.append(f"  {BOLD}{clip(stripped.lstrip('#').strip(), width - 2)}{RESET}")
        else:
            indent = " " * (len(line) - len(line.lstrip()))
            bullet = stripped[:2] in ("- ", "* ") or re.match(r"\d+\. ", stripped)
            hang = indent + ("  " if bullet else "")
            marked = re.sub(r"\*\*(.+?)\*\*", BOLD_START + r"\1" + BOLD_END, stripped)
            wrapped = textwrap.wrap(marked, width - 2, initial_indent=indent, subsequent_indent=hang) or [""]
            for w in bold_across_lines(wrapped):
                lines.append("  " + CODE_SPAN.sub(DIM + "`" + RESET + r"\1" + DIM + "`" + RESET, w))
    while lines and not lines[-1].strip():
        lines.pop()
    return lines


def conversation(path):
    """(role, text) turns with consecutive turns by the same speaker merged."""
    turns = []
    with open(path, "rb") as f:
        for raw in f:
            if b'"type":"user"' not in raw and b'"type":"assistant"' not in raw:
                continue
            e = json.loads(raw)
            text = message_text(e).strip()
            if e["type"] == "user":
                text = prompt_text(text)
            if e.get("isMeta") or not text:
                continue
            if turns and turns[-1][0] == e["type"]:
                turns[-1] = (e["type"], turns[-1][1] + "\n\n" + text)
            else:
                turns.append((e["type"], text))
    return turns


LAST_EVENTS = {
    "assistant_text": "Claude's last action was writing a reply to the developer.",
    "tool_call": "Claude's last action was starting a tool (a command, edit, or search) whose result never arrived.",
    "user_prompt": "The developer's last action was sending a request that Claude never answered.",
    "interrupted": "The developer interrupted Claude while it was working.",
}


def ending(path, turns_kept=6, clip=700):
    """How a session ended: its last few turns, clipped, and what the very last event was."""
    last_event = "assistant_text"
    with open(path, "rb") as f:
        for raw in f:
            if b'"type":"assistant"' in raw:
                last_event = "tool_call" if b'"type":"tool_use"' in raw else "assistant_text"
            elif b'"type":"user"' in raw:
                if b"[Request interrupted" in raw:
                    last_event = "interrupted"
                elif b'"tool_use_id"' in raw:
                    last_event = "tool_result"
                elif prompt_text(message_text(json.loads(raw)).strip()):
                    last_event = "user_prompt"
    if last_event == "tool_result":
        last_event = "tool_call"
    turns = [{"who": "developer" if role == "user" else "claude", "text": text[-clip:]}
             for role, text in conversation(path)[-turns_kept:]]
    return {"last_event": LAST_EVENTS[last_event], "recent_turns": turns}


STATUSES = {
    "waiting": ("waiting on you", "Claude cannot finish the developer's current request without them: it asked "
                "a question it needs answered, or needs their approval, credentials, or a choice before continuing."),
    "unfinished": ("unfinished", "Work on the developer's last request stopped before it was done: Claude was "
                   "mid-step, was interrupted, hit an error or limit, or never answered."),
    "finished": (None, "The developer's last request was completed. An optional offer of more work, such as "
                 "\"want me to also…?\", does not mean Claude is waiting."),
    "unclear": (None, "The ending does not show which of the other states applies."),
}


def judge_status(key, path):
    """(status, probability) for how the session at path ended."""
    answer = jev(key, ending(path), {"status": {
        "type": "choice",
        "instructions": "This is the end of a coding session between a developer and Claude. "
                        "In what state did the session end?",
        "criteria": {name: description for name, (_, description) in STATUSES.items()},
    }})["status"]
    return answer["choice"], answer["probabilities"][answer["choice"]]


def statuses():
    try:
        return json.loads(STATUS.read_text())
    except (OSError, ValueError):
        return {}


def status_label(path, known):
    """The label for a session's ending, if Jev judged its current transcript confidently enough to show it.
    A session still being written shows "active now" instead, since it hasn't ended, and after LABEL_DAYS a
    session you haven't returned to is no longer waiting on you."""
    entry = known.get(str(path))
    if not entry or entry["p"] < STATUS_SHOWN_AT:
        return None
    try:
        st = os.stat(path)
    except OSError:
        return None
    age = time.time() - st.st_mtime
    fresh = same_file(entry, st) and ACTIVE_SECONDS <= age < LABEL_DAYS * 86400
    return STATUSES[entry["status"]][0] if fresh else None


def label_sessions(key):
    """Judge every session whose transcript changed since it was last judged. One run at a time."""
    STATUS.parent.mkdir(parents=True, exist_ok=True)
    with open(STATUS.with_suffix(".lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return
        known = statuses()
        todo = []
        for session, _, path in index():
            st = path.stat()
            entry = known.get(str(path))
            recent = time.time() - st.st_mtime < LABEL_DAYS * 86400
            if recent and not session.throwaway and not session.active and not same_file(entry, st):
                todo.append((path, st))

        def judge(item):
            path, st = item
            try:
                status, p = judge_status(key, str(path))
            except (OSError, ValueError, KeyError):
                return None
            return str(path), {"mtime": st.st_mtime, "size": st.st_size, "status": status, "p": round(p, 3)}

        with ThreadPoolExecutor(8) as pool:
            for result in pool.map(judge, todo):
                if result:
                    known[result[0]] = result[1]
        tmp = STATUS.with_suffix(".tmp")
        tmp.write_text(json.dumps(known))
        tmp.replace(STATUS)
    port = os.environ.get("FZF_PORT")
    if port and todo:
        urllib.request.urlopen(urllib.request.Request(
            f"http://localhost:{port}", data=b"refresh-preview", method="POST"), timeout=2).close()


def speaker(role):
    return f"{ACCENT}{BOLD}you{RESET}" if role == "user" else f"{BOLD}claude{RESET}"


def excerpt(lines, keep, from_end, note):
    if len(lines) <= keep:
        return lines
    marker = f"  {SECONDARY}… {note}{RESET}"
    return [marker] + lines[-keep:] if from_end else lines[:keep] + [marker]


def preview(path):
    width = int(os.environ.get("FZF_PREVIEW_COLUMNS", "80")) - 2
    recent = "Recent" in os.environ.get("FZF_PREVIEW_LABEL", "")
    cached = load_cache().get(path) or {}
    s = Session(**cached["session"]) if cached.get("session") else None
    if s:
        dirs = config_dirs()
        config_dir = next((d for d in dirs if path.startswith(str(d) + "/")), Path(""))
        survivor = s.cwd
        while not os.path.isdir(survivor):
            survivor = os.path.dirname(survivor)
        where = tilde(s.cwd) if survivor == s.cwd else f"folder removed · resumes from {tilde(survivor)}"
        print(f"{BOLD}{one_line(s.title, width)}{RESET}")
        status = status_label(path, statuses())
        print(f"{SECONDARY}{one_line(' · '.join(meta_parts(s, config_dir, len(dirs) > 1, status)), width)}{RESET}")
        print(f"{SECONDARY}{one_line(where, width)}{RESET}")
        query = os.environ.get("FZF_QUERY", "")
        found = one_line(explained(path, query), width) or snippet(path, query)
        print(f"{SECONDARY}{found}{RESET}" if found else "")
        print()
    turns = conversation(path)
    if recent:
        for role, text in turns[-8:]:
            print(f"{speaker(role)}\n" + "\n".join(render(text, width)) + "\n")
        return
    asks = [i for i, (role, text) in enumerate(turns) if role == "user"]
    substantial = [i for i in asks if len(turns[i][1].split()) > 3]
    last_ask = (substantial or asks or [None])[-1]
    if last_ask is not None:
        print(f"{speaker('user')}\n" + "\n".join(excerpt(render(turns[last_ask][1], width), 10, False, "rest of your message")))
    reply = next((text for role, text in reversed(turns) if role == "assistant"), None)
    if reply and (last_ask is None or turns[-1][0] == "assistant"):
        print(f"\n{speaker('assistant')}\n" + "\n".join(excerpt(render(reply, width), 18, True, "earlier in this reply")))
    elif last_ask is not None:
        print(f"\n{SECONDARY}  No reply yet. Claude stopped before answering.{RESET}")


def query_palette(timeout=0.15):
    """Ask the terminal for its background, foreground, and blue (OSC 11, 10, 4;4). None when it won't say."""
    try:
        fd = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        return None
    saved = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        os.write(fd, b"\033]11;?\033\\\033]10;?\033\\\033]4;4;?\033\\\033[c")
        buf = b""
        while not re.search(rb"\033\[\?[\d;]*c", buf):
            if not select.select([fd], [], [], timeout)[0]:
                break
            buf += os.read(fd, 1024)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        os.close(fd)
    found = {}
    for key, r, g, b in re.findall(rb"\033\](11|10|4;4);rgb:([0-9a-f]+)/([0-9a-f]+)/([0-9a-f]+)", buf, re.I):
        found[key.decode()] = tuple(int(c, 16) / (16 ** len(c) - 1) for c in (r, g, b))
    return found if {"11", "10", "4;4"} <= found.keys() else None


def mix(a, b, t):
    return tuple(x + (y - x) * t for x, y in zip(a, b))


def hexcolor(rgb):
    return "#" + "".join(f"{round(c * 255):02x}" for c in rgb)


def luminance(rgb):
    return 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]


def theme():
    """(fzf --color spec for the selected row and matches, secondary text hex, background hex), hexes "" if unknown."""
    palette = None if os.environ.get("HOP_PLAIN_COLORS") else query_palette()
    if not palette:
        return "fg+:-1:reverse,bg+:-1,hl:blue,hl+:-1:reverse:bold", "", ""
    bg, fg, blue = palette["11"], palette["10"], palette["4;4"]
    accent = hexcolor(blue)
    tint = hexcolor(mix(bg, blue, 0.16 if luminance(bg) < 0.5 else 0.10))
    return f"fg+:-1,bg+:{tint},hl:{accent},hl+:{accent}:bold", hexcolor(mix(bg, fg, 0.70)), hexcolor(bg)


MARK = "\033[38;2;215;119;87m✻\033[0m"
