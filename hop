def footer(*pairs):
    key, word = "\033[22;39m", SECONDARY
    hints = " · ".join(f"{key}{k}{RESET}{word} {action}{RESET}" for k, action in pairs)
    return f"⠀\n {hints}\n⠀"


def pick():
    global SECONDARY
    selection, secondary, background = theme()
